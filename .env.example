# Vantage — environment template.
# Copy to .env and fill in. NEVER commit .env. The engine also reads real env vars
# (e.g. in cloud), so any of these can be provided by the platform instead of a file.
#
# NOTE: comments for empty keys live on their own line. `KEY=   # comment` makes the
# comment the VALUE when the key has no value, which silently poisons the setting.

# ─────────────────────────── LLM providers ───────────────────────────
# Vantage defaults to auth.mode=subscription: it runs on your Claude plan and reads NONE of these.
# They are consulted only with --auth api-key (or `vantage-engine auth use api-key`), which is
# billed per token. Leaving a key here does NOT silently meter a subscription run.
ANTHROPIC_API_KEY=
# Optional: pins every anthropic-routed agent to one model, overriding the role_model_map tiers.
ANTHROPIC_MODEL=
# Multi-provider routing (optional; enable in config.providers.*):
OPENAI_API_KEY=
# Google Gemini (AI Studio). For Vertex, use GOOGLE_APPLICATION_CREDENTIALS instead.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false      # set true to route Gemini via Vertex AI

# ─────────────────────────── Research tools ──────────────────────────
# primary web search
TAVILY_API_KEY=
# optional alternate web search (config.tools.web_search.provider=brave)
BRAVE_API_KEY=
# REQUIRED by SEC fair-access policy, format: "Jane Doe jane@example.com"
SEC_EDGAR_IDENTITY=

# ─────────────────────────── Engine defaults ─────────────────────────
VANTAGE_BACKEND=workflow         # workflow | api | agent-sdk | langgraph | adk | crewai
VANTAGE_TIER=FULL_ANNEX          # EXECUTIVE | STANDARD | FULL_ANNEX
VANTAGE_AUTH_MODE=subscription   # subscription (Claude plan, no key) | api-key (metered)
# optional path override; default ~/.config/vantage/default.json
VANTAGE_CONFIG=
# optional; default ~/.cache/vantage/run
VANTAGE_OUTPUT_DIR=
# optional; default is the bundled ./harness
VANTAGE_HARNESS_DIR=
VANTAGE_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR

# For the default `workflow` backend (runs the Claude Code Workflow — subscription, no API key):
CLAUDE_CLI=claude                    # path to the Claude Code CLI

# ─────────────────────────── Cloud: GCP ──────────────────────────────
GCP_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
# path to service-account JSON (cloud runtime / deploy)
GOOGLE_APPLICATION_CREDENTIALS=

# ─────────────────────────── Cloud: Azure ────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_LOCATION=eastus

# ─────────────────────────── Cloud: AWS ──────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# optional (temporary creds)
AWS_SESSION_TOKEN=
