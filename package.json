{
  "name": "vantage",
  "version": "0.2.0",
  "description": "Interactive Ink terminal UI (vantage-tui) for the Vantage multi-agent, multi-backend research engine.",
  "type": "module",
  "bin": {
    "vantage-tui": "tui/dist/index.js"
  },
  "files": [
    "tui/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx tui/src/index.tsx",
    "start": "node tui/dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tui/test/tsconfig.json",
    "test": "node --import tsx --test tui/test/*.test.ts tui/test/*.test.tsx",
    "prepare": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.19"
  },
  "license": "MIT"
}
