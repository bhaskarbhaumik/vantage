{
  "name": "vantage",
  "version": "0.2.0",
  "description": "Ink TUI front-end for the Vantage multi-agent, multi-backend research engine.",
  "type": "module",
  "bin": {
    "vantage": "cli/dist/index.js"
  },
  "files": [
    "cli/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx cli/src/index.tsx",
    "start": "node cli/dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "npm run build"
  },
  "dependencies": {
    "ink": "^5.0.1",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
