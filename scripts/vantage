#!/usr/bin/env bash
# Launch the Vantage TUI. Install this script as a symlink; VANTAGE_REPO overrides discovery.
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$SOURCE_DIR/$SOURCE"
done
REPO="${VANTAGE_REPO:-$(cd "$(dirname "$SOURCE")/.." && pwd)}"
ENTRY="$REPO/cli/dist/index.js"

if [[ ! -f "$ENTRY" ]]; then
  echo "vantage: TUI not built at $ENTRY" >&2
  echo "  build it with:  (cd \"$REPO\" && npm install && npm run build)" >&2
  exit 1
fi

exec node "$ENTRY" "$@"
