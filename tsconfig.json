{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "tui/dist",
    "rootDir": "tui/src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "resolveJsonModule": true
  },
  "include": ["tui/src"],
  "exclude": ["node_modules", "tui/dist", "tui/test"]
}
