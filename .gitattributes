# Normalize line endings: text files are stored and checked out with LF.
* text=auto eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary

# Generated files: collapsed in diffs and excluded from language statistics.
uv.lock linguist-generated=true
package-lock.json linguist-generated=true
completions/** linguist-generated=true
**/completions/** linguist-generated=true
